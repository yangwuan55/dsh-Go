<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application>
        <!-- Debug-only trigger for the incoming-call page; never shipped in a release APK. -->
        <receiver android:name=".notify.TelecomTestReceiver" android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.ccch1mneyyy.dsh_app.TEST_INCOMING_CALL" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
